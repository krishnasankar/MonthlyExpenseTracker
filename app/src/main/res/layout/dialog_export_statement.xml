<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <!-- Header with Title and Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btn_close"
            android:text="@string/export_statements"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/export_statements_desc"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Format Selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/export_format"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_format"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rb_format_pdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/format_pdf"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rb_format_csv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/format_csv"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </RadioGroup>

    <!-- Range Selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/export_range"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rb_range_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/range_current_month"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rb_range_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/range_all_time"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </RadioGroup>

    <!-- Progress Indicator during file writing -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_export"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <!-- Export & Share Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_export_share"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/btn_export_share"
        app:icon="@drawable/ic_export"
        app:iconGravity="textStart"
        android:textSize="14sp"
        app:cornerRadius="12dp" />

</LinearLayout>
